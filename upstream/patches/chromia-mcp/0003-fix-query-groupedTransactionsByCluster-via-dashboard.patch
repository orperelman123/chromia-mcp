From: Or Perelman <or.perelman@chromaway.com>
Date: Wed, 2 Sep 2026 08:17:05 +0300
Subject: [PATCH 3/9] fix: query groupedTransactionsByCluster via dashboardData
 (top-level field removed)

---
 .../main/kotlin/org/chromia/data/queries/NetworkQueries.kt    | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/app/src/main/kotlin/org/chromia/data/queries/NetworkQueries.kt b/app/src/main/kotlin/org/chromia/data/queries/NetworkQueries.kt
index 6b2e9ee..770dc15 100644
--- a/app/src/main/kotlin/org/chromia/data/queries/NetworkQueries.kt
+++ b/app/src/main/kotlin/org/chromia/data/queries/NetworkQueries.kt
@@ -22,7 +22,9 @@ object NetworkQueries {
     }
 
     fun getTransactionsByCluster(): GraphQLQuery = graphqlQuery {
-        query("query { groupedTransactionsByCluster { cluster, count } }")
+        // Top-level groupedTransactionsByCluster was removed from the explorer
+        // schema (FieldUndefined); the data now lives only under dashboardData.
+        query("query { dashboardData { groupedTransactionsByCluster { cluster, count } } }")
     }
 
     fun getAllAssets(): GraphQLQuery = graphqlQuery {
