From bcc4e0a17b521d5956c5969d57ba2c0b194b5885 Mon Sep 17 00:00:00 2001
From: Or Perelman <or.perelman@chromaway.com>
Date: Wed, 2 Sep 2026 08:17:29 +0300
Subject: [PATCH 6/9] fix: bind filter_assets sortBy/sortDirection - declared
 in the query but never sent

---
 app/src/main/kotlin/org/chromia/data/queries/AssetQueries.kt | 2 ++
 app/src/main/kotlin/org/chromia/domain/ChromiaRepository.kt  | 3 ++-
 app/src/main/kotlin/org/chromia/tools/ToolExecutor.kt        | 4 ++++
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/app/src/main/kotlin/org/chromia/data/queries/AssetQueries.kt b/app/src/main/kotlin/org/chromia/data/queries/AssetQueries.kt
index d720659..ff8adfd 100644
--- a/app/src/main/kotlin/org/chromia/data/queries/AssetQueries.kt
+++ b/app/src/main/kotlin/org/chromia/data/queries/AssetQueries.kt
@@ -72,5 +72,7 @@ object AssetQueries {
         filters.type?.let { variable("type", it) }
         filters.pagination.limit?.let { variable("limit", it) }
         filters.pagination.offset?.let { variable("offset", it) }
+        filters.sorting.sortBy?.let { variable("sortBy", it) }
+        filters.sorting.sortDirection?.let { variable("sortDirection", it) }
     }
 }
diff --git a/app/src/main/kotlin/org/chromia/domain/ChromiaRepository.kt b/app/src/main/kotlin/org/chromia/domain/ChromiaRepository.kt
index e57d21a..c55b9a9 100644
--- a/app/src/main/kotlin/org/chromia/domain/ChromiaRepository.kt
+++ b/app/src/main/kotlin/org/chromia/domain/ChromiaRepository.kt
@@ -79,7 +79,8 @@ data class AssetSearchFilters(
     val brid: String? = null,
     val searchQuery: String? = null,
     val type: String? = null,
-    val pagination: PaginationParams = PaginationParams()
+    val pagination: PaginationParams = PaginationParams(),
+    val sorting: SortingParams = SortingParams()
 )
 
 data class TransactionFilters(
diff --git a/app/src/main/kotlin/org/chromia/tools/ToolExecutor.kt b/app/src/main/kotlin/org/chromia/tools/ToolExecutor.kt
index 98fefe6..0021a84 100644
--- a/app/src/main/kotlin/org/chromia/tools/ToolExecutor.kt
+++ b/app/src/main/kotlin/org/chromia/tools/ToolExecutor.kt
@@ -365,6 +365,10 @@ class FilterAssetsStrategy : BaseToolStrategy() {
             pagination = PaginationParams(
                 limit = extractInt(args, "limit"),
                 offset = extractInt(args, "offset")
+            ),
+            sorting = SortingParams(
+                sortBy = extractString(args, "sortBy"),
+                sortDirection = extractString(args, "sortDirection")
             )
         )
 
