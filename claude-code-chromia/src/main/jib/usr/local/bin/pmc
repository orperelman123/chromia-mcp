#!/bin/sh

set -eu

APP_HOME=/opt/chromia/pmc

JAR=$(find "$APP_HOME/lib" -maxdepth 1 -regex '.*/management-console-.[^/]*.jar')

RESOLVED_TMP_DIR=${TMPDIR-/tmp}
LOG_FOLDER="${RESOLVED_TMP_DIR%/}/chromia"

exec ${RELL_JAVA:-java} ${JAVA_ARGS:-} -Duser.language=en -Duser.country=US -DCHR_LOG_FOLDER="$LOG_FOLDER" -cp "$JAR:$APP_HOME/lib/*" net.postchain.mc.Directory1Kt "$@"
